{
  "rewrites": [
    { "source": "/signaldesk", "destination": "/" },
    { "source": "/dashboards", "destination": "/" },
    { "source": "/team", "destination": "/" },
    { "source": "/case-:slug", "destination": "/" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
