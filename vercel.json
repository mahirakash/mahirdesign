{
  "rewrites": [
    { "source": "/signaldesk", "destination": "/" },
    { "source": "/dashboards", "destination": "/" },
    { "source": "/team", "destination": "/" },
    { "source": "/case-:slug", "destination": "/" }
  ],
  "headers": [
    { "source": "/assets/(.*)\\.(webp|png|jpg|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/assets/(.*)\\.(css|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
